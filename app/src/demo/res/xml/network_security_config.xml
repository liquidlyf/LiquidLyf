<?xml version="1.0" encoding="utf-8"?>
<!--
    demo flavor only. The Firebase Emulator Suite speaks plain HTTP, so cleartext is allowed
    to the local machine and nowhere else. dev and prod builds never include this file.
    127.0.0.1 = this phone (after `adb reverse`); 10.0.2.2 = the PC, seen from the Android emulator.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
