<?xml version="1.0" encoding="utf-8"?>
<!--
    Resources the release shrinker must keep although no code names them directly.
    default_web_client_id is generated by the google-services plugin (dev/prod only) and read
    by name at runtime (core/data/auth/Credentials.kt) to show "Continue with Google".
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
