<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 6-11 (API 23-30). Same policy as data_extraction_rules.xml: back up nothing
    (BUG-040). DataStore settings, the Firestore cache and Firebase IDs stay on this device.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
