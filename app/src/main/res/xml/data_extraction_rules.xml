<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+). Nothing in this app is worth restoring, and some of it must never
    move to another device (BUG-040): DataStore settings, the Firestore offline cache and the
    Firebase installation IDs and tokens. The account and its data live in Firestore and
    come back after sign-in.
    Cloud backup is also off through android:allowBackup="false"; device-to-device transfer
    ignores that flag on Android 12+, so it is excluded here too.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
