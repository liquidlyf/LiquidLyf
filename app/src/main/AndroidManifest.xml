<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The offline banner (NetworkMonitor). A normal permission: no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+: asked in context after profile setup, never at start (Phase 3.9). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No Analytics in v1 and no ads (A32-3): the Advertising ID permission never gets in, even
         if a library adds it later. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".LiquidLyfApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidLyf"
        tools:targetApi="33">

        <!-- singleTop: after a notification tap opened the app, a launcher tap reuses that screen
             instead of stacking a second MainActivity on it (A16, 15 Nov 2026). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LiquidLyf.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- liquidlyf://request/{id}: opens a request (Phase 4; notification taps in Phase 5). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- liquidlyf://request/{id} (alerts), liquidlyf://moderation (the admins' new-report alert, Phase 7),
                     liquidlyf://become-donor (D29's reminder). -->
                <data android:scheme="liquidlyf" />
                <data android:host="request" />
                <data android:host="moderation" />
                <data android:host="become-donor" />
            </intent-filter>
            <!-- D31: a shared request's link, https://liquidlyf.github.io/r/#{id} (C's /r/ page for people
                 without the app). Verified once the site serves assetlinks.json with the release key (A48);
                 until then Android 11 asks, and 12+ opens the page, whose button uses liquidlyf://request. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="liquidlyf.github.io" />
                <data android:path="/r/" />
                <data android:path="/r" />
                <data android:path="/r/index.html" />
            </intent-filter>
        </activity>

        <!-- D29: "Don't remind me" on the become-a-donor reminder. Only the app's own notification sends it. -->
        <receiver
            android:name=".notifications.DonorReminderReceiver"
            android:exported="false" />

        <!-- The Worker's topic alerts (doc 10 §6). Not exported: only Firebase delivers to it. -->
        <service
            android:name=".notifications.LiquidLyfMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Per-app language on Android 12 and older (AppCompat stores the choice). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Push token only where FCM exists (dev, prod); the demo flavor has none. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="${fcmAutoInitEnabled}" />

        <!-- Crash reports only from prod builds; demo and dev keep collection off. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsCollectionEnabled}" />
    </application>

</manifest>
